{
  "name": "@xcvzlabs/env",
  "description": "Environment configuration loader and validator",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "check": "bun run fmt && bun run fmt:check && bun run lint",
    "typecheck": "tsc --noEmit --checkers 8",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "vitest": "^4.1.11"
  }
}
